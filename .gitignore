# ============================================================================
# Publish policy: the website is site/, generated from src/ by `npm run build`
# and deployed by the manual Pages workflow. Code: phdef/, examples/, tests/.
# Everything below is raw/large research data, logs, or secrets -> NEVER commit.
# ============================================================================

# --- Website tooling ---
node_modules/
.venv/
playwright-report/
test-results/
.pytest_cache/

# --- Raw / large research data ---
*.wfc
*.save/
*.cube
*.npy
*.npz
*.bin
*.h5
*.dat
*.upf
*.UPF
*.hdf5

# --- QE save dirs & scheduler output / logs ---
*.save
dout/
out/
*.out
*.err
*.log
slurm-*.out

# --- Local / private config & anything credential-like ---
.claude/
.env
*.key
*.pem
*.p12
*.token
*secret*
*credential*
id_rsa*
id_ed25519*

# --- Python / tooling caches ---
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# --- Editor / OS cruft ---
*~
.DS_Store
.vscode/
*.swp
*.swo
.*.sw[a-p]

# --- EDT build artifacts ---
*.o
*.mod
*.x
*.a
